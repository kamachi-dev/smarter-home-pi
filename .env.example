# Server Configuration
PORT=4000
HOST=0.0.0.0

# Smarter Home Next.js Web App Integration
API_URL=http://localhost:3000
SMARTER_HOME_API_KEY=pi-secret-key-default
SYNC_INTERVAL_MS=3000

# Supabase Direct Sync (Optional - from smarter-home project)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-publishable-key

# Simulation Flag (force software mock mode even on Linux)
FORCE_SIMULATION=false
